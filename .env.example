# Athenaeum server configuration. Copy to .env and adjust.
# .env is gitignored; never commit real secrets.

# REQUIRED: signs session cookies and derives the Fernet key that encrypts
# per-user LLM API keys at rest. ENFORCED at boot: the value below (the
# shipped placeholder), an empty value, and keys shorter than 32 characters
# are rejected with a hard boot error. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ATHENAEUM_SECRET_KEY=change-me-generate-a-random-hex-key

# Single persistence root: app.db + users/<user_id>/library/ live under it.
#ATHENAEUM_DATA_ROOT=./data

# Uvicorn bind address / port (docker-compose sets HOST=0.0.0.0).
#ATHENAEUM_HOST=127.0.0.1
#ATHENAEUM_PORT=8000

# Logging verbosity.
#ATHENAEUM_LOG_LEVEL=INFO

# Trusted reverse proxies for X-Forwarded-* headers (client-IP login
# throttling depends on an honest request.client.host). Default: only a
# loopback proxy (127.0.0.1) is trusted. When the proxy runs in a SEPARATE
# container/host, set this to its IP or subnet so forwarded headers from it
# are honored — e.g. ATHENAEUM_FORWARDED_ALLOW_IPS=172.16.0.0/12.
#ATHENAEUM_FORWARDED_ALLOW_IPS=

# Optional first-run owner pre-seed; consumed only while the users table is
# empty, never logged, ignored once any user exists. The password must meet
# the same policy as the setup form (>= 12 characters) or the pre-seed is
# refused with a log line.
#ATHENAEUM_BOOTSTRAP_ADMIN_USERNAME=
#ATHENAEUM_BOOTSTRAP_ADMIN_PASSWORD=
