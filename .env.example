# Athenaeum server configuration. Copy to .env and adjust.
# .env is gitignored; never commit real secrets.

# REQUIRED: signs session cookies and derives the Fernet key that encrypts
# per-user LLM API keys at rest. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ATHENAEUM_SECRET_KEY=change-me-generate-a-random-hex-key

# Single persistence root: app.db + users/<user_id>/library/ live under it.
#ATHENAEUM_DATA_ROOT=./data

# Uvicorn bind address / port (docker-compose sets HOST=0.0.0.0).
#ATHENAEUM_HOST=127.0.0.1
#ATHENAEUM_PORT=8000

# Logging verbosity.
#ATHENAEUM_LOG_LEVEL=INFO

# Optional first-run owner pre-seed; consumed only while the users table is
# empty, never logged, ignored once any user exists.
#ATHENAEUM_BOOTSTRAP_ADMIN_USERNAME=
#ATHENAEUM_BOOTSTRAP_ADMIN_PASSWORD=
